<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_ProjectApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Python BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Process_ProjectApproval">
    <bpmn:participant id="Participant_Process_ProjectApproval" name="University Final-Year Project Approval &amp; Allocation" processRef="Process_ProjectApproval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProjectApproval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_ProjectApproval">
      <bpmn:lane id="Lane_Student" name="Student Team">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeSubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_ReviseTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coord" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_ReviewLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DeadlineMissed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualAlloc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyManual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyTeamRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Similar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GuideFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_NotifyError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>Task_GuideReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_GuideTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GuideAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseSlot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (HoD)">
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_ReviewSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RevCycles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Withdrawal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Proposal window opens">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_MergeSubmit">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Submit" name="Submit project proposal">
      <bpmn:documentation>Team fills title, abstract, objectives, domain, member roll numbers and preferred guides.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Ev_Deadline" name="Deadline passed (F4)" attachedToRef="Task_Submit">
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ev_Deadline_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P21D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_Correct" name="Correct / modify proposal">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Revise" name="Revise proposal per comments">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Ev_ReviseTimeout" name="7 days (F5)" attachedToRef="Task_Revise">
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ev_ReviseTimeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Lapsed" name="Proposal lapsed">
      <bpmn:incoming>Flow_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Allocated" name="Project allocated">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ReviewLate" name="Review late-submission request">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Late" name="Late entry allowed?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_DeadlineMissed" name="Deadline missed">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Screen" name="Screen proposal">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewMatch" name="Review similarity match (F3)">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Match" name="Outcome?">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Duplicate" name="Rejected: duplicate topic">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_Duplicate_def" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ManualAlloc" name="Allocate guide manually / co-guide / wait-list">
      <bpmn:incoming>Flow_47</bpmn:incoming>
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_NotifyManual" name="Notify team manually (F10)">
      <bpmn:incoming>Flow_53</bpmn:incoming>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Task_Validate" name="Validate form &amp; team rules">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Valid?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Attempts" name="Attempts &lt; 2?">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyTeamRule" name="Notify team-rule violation">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_InvalidTeam" name="Invalid team (F2)">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_InvalidTeam_def" errorRef="Error_2" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Similarity" name="Run similarity / duplicate check">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Similar" name="Similarity &gt; threshold?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Rule" name="Match guide by domain &amp; workload">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_GuideFound" name="Guide available?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendRequest" name="Send allocation request to guide">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Record" name="Record allocation">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Ev_CompRecord" attachedToRef="Task_Record">
      <bpmn:compensateEventDefinition id="Ev_CompRecord_def" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_Notify" name="Notify team &amp; coordinator">
      <bpmn:documentation>Standard loop: retried up to 3 times before the error boundary fires.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Ev_NotifyError" name="Mail / DB failure (F10)" attachedToRef="Task_Notify">
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Ev_NotifyError_def" errorRef="Error_3" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_GuideReview" name="Review allocation request">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Ev_GuideTimeout" name="No reply in 3 days (F9)" attachedToRef="Task_GuideReview">
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ev_GuideTimeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_Accept" name="Accepted?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_GuideAttempts" name="Attempts &lt; 3?">
      <bpmn:incoming>Flow_49</bpmn:incoming>
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleaseSlot" name="Release guide slot" isForCompensation="true">
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Evaluate" name="Evaluate proposal">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Ev_ReviewSLA" name="SLA breached (F7)" attachedToRef="Task_Evaluate" cancelActivity="false">
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ev_ReviewSLA_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/P5D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_Remind" name="Remind members / escalate to HoD">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Reminded" name="Reminder sent">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Committee decision?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_RevCycles" name="Revision cycles &lt; 2?">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendReasons" name="Send rejection reasons">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_NewTopic" name="New topic already used?">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Proposal rejected">
      <bpmn:incoming>Flow_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Withdrawal" name="Withdrawal after allocation (F11)" triggeredByEvent="true">
      <bpmn:startEvent id="Ev_WithdrawStart" name="Team dissolves / guide on leave">
        <bpmn:outgoing>Flow_1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Ev_WithdrawStart_def" messageRef="Message_1" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Ev_Compensate" name="Undo allocation">
        <bpmn:incoming>Flow_1</bpmn:incoming>
        <bpmn:outgoing>Flow_2</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="Ev_Compensate_def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="Task_Requeue" name="Return team to allocation queue">
        <bpmn:incoming>Flow_2</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_Requeued" name="Team re-queued">
        <bpmn:incoming>Flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1" sourceRef="Ev_WithdrawStart" targetRef="Ev_Compensate" />
      <bpmn:sequenceFlow id="Flow_2" sourceRef="Ev_Compensate" targetRef="Task_Requeue" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Requeue" targetRef="End_Requeued" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Start" targetRef="Gw_MergeSubmit" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_MergeSubmit" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_8" name="Valid" sourceRef="Gw_Valid" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Screen" targetRef="Task_Similarity" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Similarity" targetRef="Gw_Similar" />
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="Gw_Similar" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Evaluate" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_13" name="Approved" sourceRef="Gw_Decision" targetRef="Task_Rule" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Rule" targetRef="Gw_GuideFound" />
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Gw_GuideFound" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SendRequest" targetRef="Task_GuideReview" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_GuideReview" targetRef="Gw_Accept" />
    <bpmn:sequenceFlow id="Flow_18" name="Accepted" sourceRef="Gw_Accept" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Record" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Notify" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Ev_Deadline" targetRef="Task_ReviewLate" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ReviewLate" targetRef="Gw_Late" />
    <bpmn:sequenceFlow id="Flow_23" name="Yes" sourceRef="Gw_Late" targetRef="Gw_MergeSubmit" />
    <bpmn:sequenceFlow id="Flow_24" name="No" sourceRef="Gw_Late" targetRef="End_DeadlineMissed" />
    <bpmn:sequenceFlow id="Flow_25" name="Incomplete (F1)" sourceRef="Gw_Valid" targetRef="Gw_Attempts" />
    <bpmn:sequenceFlow id="Flow_26" name="Yes" sourceRef="Gw_Attempts" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="Flow_27" name="No: escalate" sourceRef="Gw_Attempts" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_28" name="Resubmit" sourceRef="Task_Correct" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_29" name="Team rule broken (F2)" sourceRef="Gw_Valid" targetRef="Task_NotifyTeamRule" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_NotifyTeamRule" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="Flow_31" name="Yes (F3)" sourceRef="Gw_Similar" targetRef="Task_ReviewMatch" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ReviewMatch" targetRef="Gw_Match" />
    <bpmn:sequenceFlow id="Flow_33" name="Acceptable" sourceRef="Gw_Match" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_34" name="Modify topic" sourceRef="Gw_Match" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="Flow_35" name="Reject" sourceRef="Gw_Match" targetRef="End_Duplicate" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Ev_ReviewSLA" targetRef="Task_Remind" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_Remind" targetRef="End_Reminded" />
    <bpmn:sequenceFlow id="Flow_38" name="Revise (F5)" sourceRef="Gw_Decision" targetRef="Gw_RevCycles" />
    <bpmn:sequenceFlow id="Flow_39" name="Yes" sourceRef="Gw_RevCycles" targetRef="Task_Revise" />
    <bpmn:sequenceFlow id="Flow_40" name="No" sourceRef="Gw_RevCycles" targetRef="Task_SendReasons" />
    <bpmn:sequenceFlow id="Flow_41" name="Resubmitted" sourceRef="Task_Revise" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Ev_ReviseTimeout" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="Flow_43" name="Rejected (F6)" sourceRef="Gw_Decision" targetRef="Task_SendReasons" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Task_SendReasons" targetRef="Gw_NewTopic" />
