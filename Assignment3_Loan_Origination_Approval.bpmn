      <bpmn:outgoing>Flow_70</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejUW" name="Rejected: underwriting">
      <bpmn:incoming>Flow_70</bpmn:incoming>
    </bpmn:endEvent>
