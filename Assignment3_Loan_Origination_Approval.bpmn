<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_LoanOrigination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Python BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Process_LoanOrigination">
