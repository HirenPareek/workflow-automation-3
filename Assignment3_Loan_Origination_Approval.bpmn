      <bpmn:errorEventDefinition id="Ev_DisburseError_def" errorRef="Error_1" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_HoldFunds" name="Hold funds &amp; contact applicant">
      <bpmn:incoming>Flow_76</bpmn:incoming>
      <bpmn:outgoing>Flow_77</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_AcctFixed" name="Account corrected?">
      <bpmn:incoming>Flow_77</bpmn:incoming>
      <bpmn:outgoing>Flow_78</bpmn:outgoing>
      <bpmn:outgoing>Flow_79</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ev_UndoAcct" name="Undo account">
      <bpmn:incoming>Flow_79</bpmn:incoming>
      <bpmn:outgoing>Flow_80</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_UndoAcct_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_DisburseFailed" name="Disbursement failed">
      <bpmn:incoming>Flow_80</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyDisbursed" name="Notify applicant">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Disbursed" name="Loan disbursed">
      <bpmn:incoming>Flow_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Withdraw" name="Applicant withdraws at any stage (L10)" triggeredByEvent="true">
