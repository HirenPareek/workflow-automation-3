      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Ev_CompAcct" attachedToRef="Task_CreateAcct">
      <bpmn:compensateEventDefinition id="Ev_CompAcct_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ReverseAcct" name="Reverse loan account" isForCompensation="true">
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_VerifyBenef" name="Verify beneficiary bank account">
      <bpmn:incoming>Flow_42</bpmn:incoming>
