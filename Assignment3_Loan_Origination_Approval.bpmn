    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Disburse" name="Disburse funds">
      <bpmn:documentation>Standard loop: payment gateway call retried up to 2 times before the error boundary fires.</bpmn:documentation>
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:incoming>Flow_78</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Ev_DisburseError" name="Payment failed (L12)" attachedToRef="Task_Disburse">
