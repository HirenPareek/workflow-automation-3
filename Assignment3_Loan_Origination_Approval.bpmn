        <bpmn:messageEventDefinition id="Ev_WithdrawStart_def" messageRef="Message_2" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Ev_CompAll" name="Refund fee, release holds">
        <bpmn:incoming>Flow_1</bpmn:incoming>
        <bpmn:outgoing>Flow_2</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="Ev_CompAll_def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="Task_Close" name="Close application">
        <bpmn:incoming>Flow_2</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Withdrawn" name="Application withdrawn">
        <bpmn:incoming>Flow_3</bpmn:incoming>
      </bpmn:endEvent>
